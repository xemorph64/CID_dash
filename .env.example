# Copy to .env and fill in locally. Never commit .env.

# Postgres (architecture.md §5.1)
POSTGRES_USER=cid
POSTGRES_PASSWORD=cidlocaldev
POSTGRES_DB=cid
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Neo4j (architecture.md §5.2)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cidlocaldev

# Generate locally: openssl rand -hex 32
HMAC_KEY=
JWT_SECRET=

# Set automatically by the app at runtime once models are cached (architecture.md §2 principle 7)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
