    "react-dom": "^18.3.1",
    "@fontsource/anek-latin": "^5.3.0",
    "@fontsource/anek-devanagari": "^5.3.0",
    "@fontsource/anek-tamil": "^5.3.0",
    "@fontsource/anek-bangla": "^5.3.0",
    "@fontsource/tiro-devanagari-hindi": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
